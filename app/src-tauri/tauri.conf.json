{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XRD Studio",
  "mainBinaryName": "XRD Studio",
  "version": "0.4.0",
  "identifier": "studio.xrd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "..\\engine\\.venv\\Scripts\\python.exe ..\\engine\\scripts\\build_sidecar.py",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XRD Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 760,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/xrd-engine.exe": "xrd-engine.exe",
      "sidecar/_internal": "_internal"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}

